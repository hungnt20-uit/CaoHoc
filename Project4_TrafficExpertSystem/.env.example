# MẪU — KHÔNG đặt key thật vào file này (.env.example được commit lên git).
# Key thật đặt trong .env (đã gitignore, không bao giờ bị commit).
#
# Chọn 1 trong 2 provider LLM (ưu tiên Anthropic nếu cả hai cùng có):
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
#
# Tùy chọn:
# TRAFFIC_ES_LLM_PROVIDER=openai          # anthropic | openai | local
# TRAFFIC_ES_LLM_MODEL=gpt-4o-mini
#
# LLM local, không tốn phí token — chạy notebooks/colab_qwen_server.ipynb trên Colab
# rồi dán URL nó in ra (URL trycloudflare đổi mỗi lần chạy lại notebook):
# TRAFFIC_ES_LLM_PROVIDER=local
# TRAFFIC_ES_LOCAL_BASE_URL=https://xxx.trycloudflare.com/v1
# TRAFFIC_ES_LOCAL_MODEL=Qwen/Qwen2.5-Coder-7B-Instruct
# TRAFFIC_ES_LOCAL_API_KEY=              # chỉ cần nếu server local có bật xác thực
